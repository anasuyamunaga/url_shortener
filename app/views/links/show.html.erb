<% content_for :title, @link.name.presence || @link.slug %>

<div class="space-y-8">
  <%# Header %>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 text-sm text-zinc-400 mb-1">
        <%= link_to "← Dashboard", root_path, class: "hover:text-zinc-200 transition-colors" %>
      </div>
      <h1 class="text-2xl font-bold text-white truncate">
        <%= @link.name.presence || "/r/#{@link.slug}" %>
      </h1>
      <p class="text-zinc-400 text-sm mt-1 truncate">
        <a href="<%= @link.target_url %>" target="_blank" rel="noopener noreferrer"
           class="hover:text-indigo-400 transition-colors">
          <%= @link.target_url %>
        </a>
      </p>
    </div>

    <div class="shrink-0 text-right">
      <p class="text-3xl font-bold tabular-nums text-white"><%= number_with_delimiter(@total_human_visits) %></p>
      <p class="text-xs text-zinc-400 mt-0.5">human clicks</p>
    </div>
  </div>

  <%# Short link box %>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-4 flex items-center justify-between gap-4">
    <div>
      <p class="text-xs text-zinc-400 mb-0.5">Your short link</p>
      <a href="<%= redirect_url(@link.slug) %>"
         target="_blank" rel="noopener noreferrer"
         class="text-indigo-400 hover:text-indigo-300 font-mono font-semibold transition-colors">
        <%= redirect_url(@link.slug) %>
      </a>
    </div>
    <span class="text-xs text-zinc-500">Created <%= @link.created_at.strftime("%b %-d, %Y") %></span>
  </div>

  <%# Visits table %>
  <div>
    <h2 class="text-base font-semibold text-white mb-3">
      Recent visits
      <span class="text-zinc-500 font-normal text-sm">(last 50, including bots)</span>
    </h2>

    <% if @visits.empty? %>
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/30 py-12 text-center">
        <p class="text-zinc-500 text-sm">No visits yet. Share your short link to get started.</p>
      </div>
    <% else %>
      <div class="rounded-xl border border-zinc-800 overflow-hidden">
        <table class="w-full text-xs">
          <thead class="bg-zinc-900 border-b border-zinc-800">
            <tr>
              <th class="px-4 py-2.5 text-left font-medium text-zinc-400">Time</th>
              <th class="px-4 py-2.5 text-left font-medium text-zinc-400">User Agent</th>
              <th class="px-4 py-2.5 text-left font-medium text-zinc-400">Referrer</th>
              <th class="px-4 py-2.5 text-center font-medium text-zinc-400">Bot?</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/60">
            <% @visits.each do |visit| %>
              <tr class="<%= visit.bot? ? 'bg-zinc-900/30 text-zinc-500' : 'bg-zinc-950 text-zinc-300' %> hover:bg-zinc-900/50 transition-colors">
                <td class="px-4 py-2.5 tabular-nums whitespace-nowrap">
                  <time datetime="<%= visit.visited_at.iso8601 %>" title="<%= visit.visited_at.utc %>">
                    <%= visit.visited_at.strftime("%b %-d %H:%M:%S UTC") %>
                  </time>
                </td>
                <td class="px-4 py-2.5 max-w-xs">
                  <span class="truncate block" title="<%= visit.user_agent %>">
                    <%= visit.user_agent.presence || "—" %>
                  </span>
                </td>
                <td class="px-4 py-2.5 max-w-xs">
                  <span class="truncate block" title="<%= visit.referrer %>">
                    <% if visit.referrer.present? %>
                      <%= visit.referrer %>
                    <% else %>
                      <span class="text-zinc-600">—</span>
                    <% end %>
                  </span>
                </td>
                <td class="px-4 py-2.5 text-center">
                  <% if visit.bot? %>
                    <span class="inline-block rounded-full bg-amber-900/40 text-amber-400 px-2 py-0.5 text-xs">bot</span>
                  <% else %>
                    <span class="text-zinc-700">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
