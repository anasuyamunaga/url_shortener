<% content_for :title, "Dashboard" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">Dashboard</h1>
      <p class="text-sm text-zinc-400 mt-0.5"><%= pluralize(@links.size, "link") %></p>
    </div>
  </div>

  <% if @links.empty? %>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 px-8 py-16 text-center">
      <p class="text-zinc-400 text-sm">No links yet.</p>
      <%= link_to "Create your first short link →", new_link_path,
            class: "mt-4 inline-block text-indigo-400 hover:text-indigo-300 text-sm font-medium transition-colors" %>
    </div>
  <% else %>
    <div class="rounded-xl border border-zinc-800 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-zinc-900 border-b border-zinc-800">
          <tr>
            <th class="px-4 py-3 text-left font-medium text-zinc-400">Name / Target</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-400">Short Link</th>
            <th class="px-4 py-3 text-right font-medium text-zinc-400">Clicks</th>
            <th class="px-4 py-3 text-right font-medium text-zinc-400">Created</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800">
          <% @links.each do |link| %>
            <tr class="bg-zinc-950 hover:bg-zinc-900/60 transition-colors">
              <td class="px-4 py-3 max-w-xs">
                <% if link.name.present? %>
                  <p class="font-medium text-white truncate"><%= link.name %></p>
                <% end %>
                <p class="text-zinc-400 truncate text-xs mt-0.5"><%= link.target_url %></p>
              </td>
              <td class="px-4 py-3 font-mono">
                <a href="<%= redirect_url(link.slug) %>"
                   class="text-indigo-400 hover:text-indigo-300 transition-colors"
                   target="_blank" rel="noopener noreferrer">
                  /r/<%= link.slug %>
                </a>
              </td>
              <td class="px-4 py-3 text-right tabular-nums text-white font-medium">
                <%= number_with_delimiter(@click_counts[link.id] || 0) %>
              </td>
              <td class="px-4 py-3 text-right text-zinc-400 tabular-nums text-xs">
                <%= link.created_at.strftime("%b %-d, %Y") %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Details →", link_path(link.slug),
                      class: "text-xs text-zinc-500 hover:text-indigo-400 transition-colors font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
